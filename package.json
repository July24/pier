{
  "name": "pier-setup",
  "version": "0.2.6",
  "description": "One-shot installer for pier: install / update / version / uninstall for pi-pier + pier.workbench",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pier-setup": "./install.mjs"
  },
  "files": [
    "install.mjs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/July24/pier.git"
  },
  "homepage": "https://github.com/July24/pier#readme",
  "bugs": {
    "url": "https://github.com/July24/pier/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pier",
    "installer",
    "herdr",
    "coding-agent"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.ts\"",
    "test:mutation": "stryker run",
    "prepare": "node ./install.mjs --prepare"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-group": "^1.0.1",
    "@deepseek-ai/cordis-plugin-hmr": "^1.0.16",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.2",
    "@deepseek-ai/cordis-plugin-timer": "^1.1.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0"
  },
  "pi": {
    "extensions": [
      "./packages/pier-ext/src/index.ts"
    ],
    "skills": [
      "./packages/pier-ext/skills/pi-herdr-workflow"
    ]
  }
}
