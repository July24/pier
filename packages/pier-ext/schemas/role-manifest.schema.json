{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://herdr-pi.local/schemas/role-manifest.schema.json",
  "title": "herdr-pi role manifest（D76 v2）",
  "description": "档2 role 档案契约：version（P2 语义版本）+ roleType（P3 planner/executor/hybrid）+ 三态 rules（P1 allow/ask/deny）。运行时校验为 src/role-manifest.ts 手写零依赖实现，本文件是合同文档。",
  "type": "object",
  "properties": {
    "role": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "角色名，须与文件名一致" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "语义版本 x.y.z" },
    "model": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$", "description": "按角色路由模型 provider/model（WS-D10；可省略 = 进程默认）" },
    "description": { "type": "string" },
    "manifest": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "uniqueItems": true,
          "description": "基线工具；必含 todo_write 与 ask_user_question（协调工具，运行时校验强制）"
        },
        "rules": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9_*-]+$" },
          "additionalProperties": { "enum": ["allow", "ask", "deny"] },
          "description": "三态权限；* 为通配符默认；可省略 = {\"*\":\"allow\"}"
        },
        "unknownTools": {
          "enum": ["allow", "deny"],
          "description": "D82 未知工具姿态（缺省 deny）：allow = 用户安装的扩展默认可见可用（master/worker）；deny = 清单外一律不可见。与 rules 的 * 通配分属两轴（可见性 vs 强制力）"
        }
      },
      "required": ["tools"],
      "additionalProperties": false
    },
    "services": {
      "type": "object",
      "properties": {
        "todos": {
          "type": "object",
          "properties": {
            "mode": { "enum": ["serial", "parallel"] },
            "reminderLimit": { "type": "integer", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["role", "version", "manifest"],
  "additionalProperties": false
}
