{
  "role": "master",
  "version": "1.3.1",
  "description": "主控角色（WS-D7 自应用；D83 镜像源）：自研核心全量（todos/协调/subagent 族/终端族）+ pi 内建检视执行 + web_search；D82 unknownTools=allow——用户安装的任意扩展默认可见可用（install 即授予）",
  "manifest": {
    "unknownTools": "allow",
    "tools": [
      "todo_write", "ask_user_question",
      "subagent", "resume_subagent", "list_agents", "send_message", "interrupt_agent",
      "terminal_open", "terminal_send", "terminal_read", "terminal_signal", "terminal_close", "terminal_list",
      "read", "grep", "glob", "bash", "pwsh", "edit", "write",
      "web_search"
    ],
    "rules": {
      "*": "allow"
    }
  },
  "services": {
    "todos": { "mode": "parallel" }
  }
}
