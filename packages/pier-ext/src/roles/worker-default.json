{
  "role": "worker-default",
  "version": "1.4.0",
  "description": "默认worker角色（D83 继承制）：镜像 master.tools 减 subagent/terminal（禁嵌套、资源归属）；排除族显式 deny——在 D82 unknownTools=allow 姿态下仍持禁令；todos serial。v1.4.0: 工具合并后更新 deny 列表",
  "manifest": {
    "unknownTools": "allow",
    "tools": [
      "todo_write", "ask_user_question",
      "read", "grep", "glob", "bash", "pwsh", "edit", "write",
      "web_search"
    ],
    "rules": {
      "subagent": "deny",
      "terminal": "deny",
      "*": "allow"
    }
  },
  "services": {
    "todos": { "mode": "serial" }
  }
}
