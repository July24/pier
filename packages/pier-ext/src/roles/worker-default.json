{
  "role": "worker-default",
  "version": "1.3.1",
  "description": "默认worker角色（D83 继承制）：镜像 master.tools 减 subagent 族（禁嵌套）减 terminal 族（M14 资源归属）；排除族显式 deny——在 D82 unknownTools=allow 姿态下仍持禁令；todos serial",
  "manifest": {
    "unknownTools": "allow",
    "tools": [
      "todo_write", "ask_user_question",
      "read", "grep", "glob", "bash", "pwsh", "edit", "write",
      "web_search"
    ],
    "rules": {
      "subagent": "deny",
      "resume_subagent": "deny",
      "list_agents": "deny",
      "send_message": "deny",
      "interrupt_agent": "deny",
      "terminal_open": "deny",
      "terminal_send": "deny",
      "terminal_read": "deny",
      "terminal_signal": "deny",
      "terminal_close": "deny",
      "terminal_list": "deny",
      "*": "allow"
    }
  },
  "services": {
    "todos": { "mode": "serial" }
  }
}
