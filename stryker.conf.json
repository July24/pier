{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --test packages/pier-ext/test/*.test.ts"
  },
  "mutate": [
    "packages/pier-ext/src/todo-core.ts",
    "packages/pier-ext/src/tool-gate.ts",
    "packages/pier-ext/src/reconcile-core.ts",
    "packages/pier-ext/src/lock-core.ts",
    "packages/pier-ext/src/pipe-channel.ts",
    "packages/pier-ext/src/gc-core.ts"
  ],
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "timeoutMS": 12000,
  "concurrency": 4,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "coverageAnalysis": "off",
  "reporters": ["html", "clear-text", "progress", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/html/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  }
}
